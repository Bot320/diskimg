# SPDX-License-Identifier: GPL-3.0-only
# Arch package of diskimg built from this source tree:  cd packaging && makepkg -si
pkgname=diskimg
pkgver=4.1.1
pkgrel=1
pkgdesc="Disk imaging for Arch Linux: GTK 4 app with text-interface fallback (ddrescue, partclone, zstd, gpg, SMB/NFS, restic)"
arch=('any')
url="https://github.com/Bot320/diskimg"
license=('GPL-3.0-only')
depends=('python' 'python-textual' 'python-rich' 'ddrescue' 'gptfdisk' 'partclone' 'ntfs-3g' 'ntfsprogs' 'zstd'
         'gnupg' 'util-linux' 'e2fsprogs' 'polkit')
optdepends=('python-gobject: graphical interface'
            'gtk4: graphical interface'
            'libadwaita: graphical interface'
            'cifs-utils: SMB / Windows network shares'
            'nfs-utils: NFS network shares'
            'restic: file backups'
            'fuse3: instant browsing of backups'
            'python-pyfuse3: instant browsing of backups'
            'python-trio: instant browsing of backups'
            'python-zstandard: chunked backups with Python older than 3.14')

pkgver() {
  python -I -c 'import re,sys; print(re.search(r"^VERSION = \"([^\"]+)\"", open(sys.argv[1]).read(), re.M)[1])' \
    "$startdir/../diskimg/engine.py"
}

package() {
  local src="$startdir/.." dest="$pkgdir/usr/lib/diskimg"
  install -d "$dest"
  cp -r --no-preserve=ownership "$src/diskimg" "$src/libexec" "$src/bin" "$dest/"
  find "$dest" -name __pycache__ -prune -exec rm -rf {} +
  chmod 755 "$dest/bin/diskimg" "$dest/libexec/diskimg-run" "$dest/libexec/diskimg-helper"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/diskimg/bin/diskimg "$pkgdir/usr/bin/diskimg"
  install -Dm644 "$src/data/io.github.bot320.diskimg.desktop" \
    "$pkgdir/usr/share/applications/io.github.bot320.diskimg.desktop"
  install -Dm644 "$src/data/io.github.bot320.diskimg.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.bot320.diskimg.svg"
  install -d "$pkgdir/usr/share/polkit-1/actions"
  sed 's|@PREFIX@|/usr/lib/diskimg|g' "$src/data/io.github.bot320.diskimg.policy" \
    > "$pkgdir/usr/share/polkit-1/actions/io.github.bot320.diskimg.policy"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/diskimg/LICENSE"
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/diskimg/README.md"
  python -m compileall -q -d /usr/lib/diskimg/diskimg "$dest/diskimg"
}
